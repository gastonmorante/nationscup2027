# ==============================================================================
# NATIONS CUP 2027 — HOSTINGER APACHE / LITESPEED CONFIGURATION (.htaccess)
# Domain: https://www.nationscup2027.com
# ==============================================================================

# 1. SECURITY & OPTIONS
Options -Indexes
ServerSignature Off
AddDefaultCharset UTF-8

# MIME TYPES (Next-Gen Formats & Web Standards)
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType application/json .json
  AddType application/xml .xml
</IfModule>

# 2. CANONICAL HTTPS & WWW REDIRECTION + ROUTING
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force WWW (redirect non-www to www)
  RewriteCond %{HTTP_HOST} ^nationscup2027\.com$ [NC]
  RewriteRule ^(.*)$ https://www.nationscup2027.com/$1 [L,R=301]

  # Clean Language Subpaths: /en/ and /es/
  RewriteRule ^en/?$ index.html?lang=en [NC,QSA,L]
  RewriteRule ^es/?$ index.html?lang=es [NC,QSA,L]
  RewriteRule ^en/([a-zA-Z0-9_-]+)/?$ $1.html?lang=en [NC,QSA,L]
  RewriteRule ^es/([a-zA-Z0-9_-]+)/?$ $1.html?lang=es [NC,QSA,L]

  # Extensionless URLs (e.g. /patrocinios -> patrocinios.html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^/]+)/?$ $1.html [NC,QSA,L]

  # Transparent Next-Gen WebP Delivery for modern browsers
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME} (.+)\.(jpe?g|png)$ [NC]
  RewriteCond %1.webp -f
  RewriteRule (.+)\.(jpe?g|png)$ $1.webp [T=image/webp,E=accept:1,L]
</IfModule>

# Vary Header for WebP Content Negotiation & Security Headers
<IfModule mod_headers.c>
  Header append Vary Accept env=REDIRECT_accept
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. COMPRESSION (GZIP & DEFLATE) FOR ULTRA-FAST LOADING
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/vnd.ms-fontobject application/x-font-ttf font/opentype
</IfModule>

# 4. BROWSER CACHING (EXPIRES HEADERS)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & Data (revalidate frequently)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"

  # CSS & JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Media & Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 5. CUSTOM 404 FALLBACK
ErrorDocument 404 /index.html
